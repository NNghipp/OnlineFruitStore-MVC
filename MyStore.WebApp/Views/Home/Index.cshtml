@using MyStore.WebApp.Helpers

@{
    ViewData["Title"] = "Trang Chủ";
    var featuredProducts = ViewBag.FeaturedProducts as List<MyStore.Business.Entities.Product>;
    var categories = ViewBag.Categories as List<MyStore.Business.Entities.Category>;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Hero Section -->
<div class="hero-section">
    <div class="hero-content">
        <h1 class="hero-title">Trái Cây Tươi Mỗi Ngày</h1>
        <p class="hero-subtitle">Chuyên cung cấp trái cây nội địa và nhập khẩu tươi ngon, chất lượng cao với giá cả hợp lý.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-fruit-primary btn-lg">
            <i class="bi bi-shop"></i> Mua Ngay
        </a>
    </div>
</div>

<!-- Categories Section -->
<div class="row mb-5">
    <div class="col-12">
        <h2 class="section-title text-success">
            <i class="bi bi-tags"></i> Danh Mục Sản Phẩm
        </h2>
    </div>
    @if (categories != null)
    {
        foreach (var cate in categories)
        {
            <div class="col-md-4 mb-4">
                <div class="category-card">
                    <h4><i class="bi bi-basket2"></i> @cate.CategoryName</h4>
                </div>
            </div>
        }
    }
</div>

<!-- Featured Products Section -->
<div class="row">
    <div class="col-12">
        <h2 class="section-title text-danger">
            <i class="bi bi-fire"></i> Sản Phẩm Nổi Bật
        </h2>
    </div>
    @if (featuredProducts != null)
    {
        foreach (var item in featuredProducts)
        {
            var imageFile = FruitImageHelper.GetImageByProductName(item.ProductName);
            <div class="col-md-4 col-lg-3 mb-4">
                <div class="card product-card">
                    <div class="product-card-img-wrapper">
                        <img src="~/assets/products/@imageFile" class="product-card-img" alt="@item.ProductName">
                        @if (item.UnitsInStock < 30)
                        {
                            <span class="product-card-badge">Sắp hết</span>
                        }
                    </div>
                    <div class="product-card-body">
                        <h5 class="product-card-title">@item.ProductName</h5>
                        <p class="product-card-price">@string.Format("{0:N0} ₫", item.UnitPrice)</p>
                        <div class="product-card-actions">
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductID" class="btn btn-outline-success btn-sm">
                                <i class="bi bi-eye"></i> Chi tiết
                            </a>
                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                <input type="hidden" name="productId" value="@item.ProductID" />
                                <button type="submit" class="btn btn-add-cart btn-sm">
                                    <i class="bi bi-cart-plus"></i> Thêm
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Why Choose Us Section -->
<div class="row mt-5 mb-4">
    <div class="col-12">
        <h2 class="section-title text-success">
            <i class="bi bi-patch-check"></i> Tại Sao Chọn Chúng Tôi?
        </h2>
    </div>
    <div class="col-md-4 mb-3">
        <div class="text-center p-4">
            <i class="bi bi-truck display-4 text-success mb-3"></i>
            <h5>Giao Hàng Nhanh</h5>
            <p class="text-muted">Giao hàng trong ngày tại TP.HCM</p>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="text-center p-4">
            <i class="bi bi-shield-check display-4 text-success mb-3"></i>
            <h5>Chất Lượng Đảm Bảo</h5>
            <p class="text-muted">100% trái cây tươi ngon, nhập khẩu chính hãng</p>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="text-center p-4">
            <i class="bi bi-arrow-repeat display-4 text-success mb-3"></i>
            <h5>Đổi Trả Dễ Dàng</h5>
            <p class="text-muted">Hoàn tiền 100% nếu không hài lòng</p>
        </div>
    </div>
</div>
