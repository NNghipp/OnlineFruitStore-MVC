@{
    ViewData["Title"] = "About";
}

<h2>About</h2>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">About MyStore</h5>
        <p class="card-text">
            MyStore is a demo e-commerce application built with ASP.NET Core MVC.
        </p>
        <p>This application demonstrates:</p>
        <ul>
            <li>3-layer architecture (Business, Repository, Service)</li>
            <li>Entity Framework Core with Code First</li>
            <li>Repository Pattern for data access</li>
            <li>CRUD operations with SQL Server</li>
            <li>MVC pattern with ASP.NET Core</li>
        </ul>
    </div>
</div>
