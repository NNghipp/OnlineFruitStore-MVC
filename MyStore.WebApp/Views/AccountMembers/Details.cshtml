@model MyStore.Business.Entities.AccountMember

@{
    ViewData["Title"] = "Member Details";
}

<h2>Member Details</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Member ID</dt>
            <dd class="col-sm-9">@Model.MemberID</dd>
            
            <dt class="col-sm-3">Full Name</dt>
            <dd class="col-sm-9">@Model.FullName</dd>
            
            <dt class="col-sm-3">Email Address</dt>
            <dd class="col-sm-9">@Model.EmailAddress</dd>
            
            <dt class="col-sm-3">Role</dt>
            <dd class="col-sm-9">@Model.MemberRole</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.MemberID" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
