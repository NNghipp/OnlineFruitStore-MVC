@model MyStore.Business.Entities.AccountMember

@{
    ViewData["Title"] = "Delete Member";
}

<h2>Delete Member</h2>

<div class="alert alert-danger">
    <h5>Are you sure you want to delete this member?</h5>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Full Name</dt>
            <dd class="col-sm-9">@Model.FullName</dd>
            
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.EmailAddress</dd>
            
            <dt class="col-sm-3">Role</dt>
            <dd class="col-sm-9">@Model.MemberRole</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="MemberID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
