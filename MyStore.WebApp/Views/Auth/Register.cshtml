@model MyStore.WebApp.Models.RegisterViewModel

@{
    ViewData["Title"] = "Đăng Ký";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-container">
        <!-- Left Side - Social Register -->
        <div class="auth-social-side">
            <div class="auth-social-content">
                <div class="auth-brand">
                    <h2>🍎 MyStore</h2>
                    <p>Chợ Trái Cây Tươi Ngon</p>
                </div>
                
                <h3>Đăng ký nhanh với</h3>
                
                <div class="social-buttons">
                    <button type="button" class="btn-social btn-google">
                        <svg viewBox="0 0 24 24" width="24" height="24">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                        </svg>
                        <span>Đăng ký với Google</span>
                    </button>
                    
                    <button type="button" class="btn-social btn-facebook">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="#1877F2">
                            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                        </svg>
                        <span>Đăng ký với Facebook</span>
                    </button>
                </div>
                
                <div class="social-benefits">
                    <h4>Tại sao nên tạo tài khoản?</h4>
                    <ul>
                        <li><i class="bi bi-check-circle"></i> Theo dõi đơn hàng dễ dàng</li>
                        <li><i class="bi bi-check-circle"></i> Nhận ưu đãi độc quyền</li>
                        <li><i class="bi bi-check-circle"></i> Tích điểm đổi quà</li>
                    </ul>
                </div>
            </div>
        </div>
        
        <!-- Right Side - Register Form -->
        <div class="auth-form-side">
            <div class="auth-form-content">
                <div class="auth-form-header">
                    <div class="auth-icon">
                        <i class="bi bi-person-plus"></i>
                    </div>
                    <h2>Đăng Ký Tài Khoản</h2>
                    <p>Tạo tài khoản để mua sắm tại MyStore</p>
                </div>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" id="fullNameInput" />
                        <label for="fullNameInput"><i class="bi bi-person"></i> Họ và tên *</label>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" placeholder="email@example.com" id="emailInput" />
                        <label for="emailInput"><i class="bi bi-envelope"></i> Email *</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="PhoneNumber" class="form-control" placeholder="0901234567" id="phoneInput" />
                        <label for="phoneInput"><i class="bi bi-telephone"></i> Số điện thoại</label>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="Password" class="form-control" placeholder="••••••••" id="passwordInput" />
                                <label for="passwordInput"><i class="bi bi-lock"></i> Mật khẩu *</label>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" id="confirmInput" />
                                <label for="confirmInput"><i class="bi bi-lock-fill"></i> Xác nhận *</label>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input type="checkbox" class="form-check-input" id="agreeTerms" required>
                        <label class="form-check-label" for="agreeTerms">
                            Tôi đồng ý với <a href="#">Điều khoản sử dụng</a>
                        </label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-fruit-primary btn-lg">
                            <i class="bi bi-check-circle"></i> Đăng Ký
                        </button>
                    </div>
                </form>

                <div class="auth-footer">
                    <p>Đã có tài khoản?</p>
                    <a asp-action="Login" class="btn btn-outline-success btn-lg w-100">
                        <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .auth-page {
        min-height: calc(100vh - 200px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: linear-gradient(135deg, #f8fdf9 0%, #e8f5e9 100%);
    }
    
    .auth-container {
        display: flex;
        width: 100%;
        max-width: 1100px;
        min-height: 700px;
        background: white;
        border-radius: 24px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
        overflow: hidden;
    }
    
    /* Left Side - Social */
    .auth-social-side {
        flex: 1;
        background: var(--gradient-header);
        padding: 3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }
    
    .auth-social-side::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.08'%3E%3Ccircle cx='30' cy='30' r='4'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    
    .auth-social-content {
        position: relative;
        z-index: 1;
        text-align: center;
        color: white;
    }
    
    .auth-brand {
        margin-bottom: 2rem;
    }
    
    .auth-brand h2 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    
    .auth-brand p {
        opacity: 0.9;
        font-size: 1.1rem;
    }
    
    .auth-social-content h3 {
        font-size: 1.25rem;
        margin-bottom: 1.5rem;
        font-weight: 600;
    }
    
    .social-buttons {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    
    .btn-social {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 1rem 1.5rem;
        border: none;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    
    .btn-google {
        background: white;
        color: #333;
    }
    
    .btn-google:hover {
        background: #f8f8f8;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    }
    
    .btn-facebook {
        background: #1877F2;
        color: white;
    }
    
    .btn-facebook:hover {
        background: #1565d8;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(24, 119, 242, 0.4);
    }
    
    .social-benefits {
        margin-top: 2.5rem;
        text-align: left;
        background: rgba(255, 255, 255, 0.1);
        padding: 1.5rem;
        border-radius: 16px;
    }
    
    .social-benefits h4 {
        font-size: 1rem;
        margin-bottom: 1rem;
        font-weight: 600;
    }
    
    .social-benefits ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    
    .social-benefits li {
        padding: 0.5rem 0;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    
    .social-benefits li i {
        color: #90EE90;
    }
    
    /* Right Side - Form */
    .auth-form-side {
        flex: 1.3;
        padding: 2.5rem 3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow-y: auto;
    }
    
    .auth-form-content {
        width: 100%;
        max-width: 450px;
    }
    
    .auth-form-header {
        text-align: center;
        margin-bottom: 1.5rem;
    }
    
    .auth-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 1rem;
        background: var(--gradient-header);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .auth-icon i {
        font-size: 2rem;
        color: white;
    }
    
    .auth-form-header h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--fruit-primary);
        margin-bottom: 0.25rem;
    }
    
    .auth-form-header p {
        color: #666;
        font-size: 0.95rem;
    }
    
    .form-floating label {
        color: #666;
    }
    
    .form-control:focus {
        border-color: var(--fruit-primary);
        box-shadow: 0 0 0 0.25rem rgba(45, 138, 62, 0.15);
    }
    
    .auth-footer {
        margin-top: 1.5rem;
        text-align: center;
        padding-top: 1.5rem;
        border-top: 1px solid #eee;
    }
    
    .auth-footer p {
        color: #666;
        margin-bottom: 1rem;
    }
    
    /* Responsive */
    @@media (max-width: 768px) {
        .auth-container {
            flex-direction: column;
            max-width: 500px;
            min-height: auto;
        }
        
        .auth-social-side {
            padding: 2rem;
        }
        
        .auth-form-side {
            padding: 2rem;
        }
        
        .social-benefits {
            display: none;
        }
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
