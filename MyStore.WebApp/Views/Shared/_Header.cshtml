@using MyStore.WebApp.Services

@inject ICartService CartService
@{
    var cartCount = CartService.GetCartCount();
    var userId = Context.Session.GetInt32("UserId");
    var userName = Context.Session.GetString("UserName");
    var isLoggedIn = userId != null;
}

<header class="site-header">
    <div class="container">
        <!-- Logo -->
        <a asp-controller="Home" asp-action="Index" class="site-logo">
            <h1 class="site-logo-text">MyStore</h1>
        </a>

        <!-- Header Actions: Cart & User -->
        <div class="header-actions">
            <!-- Shopping Cart -->
            <a asp-controller="Cart" asp-action="Index" class="header-icon-btn" title="Giỏ hàng">
                <i class="bi bi-cart3"></i>
                @if (cartCount > 0)
                {
                    <span class="cart-badge">@cartCount</span>
                }
            </a>

            <!-- User Dropdown -->
            <div class="user-dropdown">
                <a href="#" class="header-icon-btn" title="Tài khoản">
                    <i class="bi bi-person"></i>
                </a>
                <div class="user-dropdown-menu">
                    @if (isLoggedIn)
                    {
                        <div class="user-dropdown-header">
                            <strong>@userName</strong>
                        </div>
                        <hr class="my-2">
                        <a asp-controller="Profile" asp-action="Index">
                            <i class="bi bi-person-circle"></i> Tài khoản của tôi
                        </a>
                        <a asp-controller="Profile" asp-action="ChangePassword">
                            <i class="bi bi-key"></i> Đổi mật khẩu
                        </a>
                        <a asp-controller="Cart" asp-action="Index">
                            <i class="bi bi-clock-history"></i> Giỏ hàng
                        </a>
                        <hr class="my-2">
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="dropdown-logout-btn">
                                <i class="bi bi-box-arrow-right"></i> Đăng xuất
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                        </a>
                        <a asp-controller="Auth" asp-action="Register">
                            <i class="bi bi-person-plus"></i> Đăng ký
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</header>

<style>
    .user-dropdown-header {
        padding: 0.75rem 1rem;
        color: var(--fruit-primary);
        font-size: 0.9rem;
    }
    
    .dropdown-logout-btn {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        width: 100%;
        padding: 0.75rem 1rem;
        border: none;
        background: transparent;
        color: #dc3545;
        text-align: left;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    
    .dropdown-logout-btn:hover {
        background: #fff0f0;
    }
</style>
