@using MyStore.WebApp.Helpers
@model IEnumerable<MyStore.Business.Entities.Product>

@{
    ViewData["Title"] = "Sản Phẩm";
    var selectedCategoryId = ViewBag.SelectedCategoryId as int?;
}

<h2><i class="bi bi-grid"></i> Danh Sách Sản Phẩm</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filter và Actions -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-6">
                <form method="get" class="d-flex gap-2">
                    <select name="categoryId" class="form-select" style="max-width: 250px;">
                        <option value="">-- Tất cả danh mục --</option>
                        @foreach (var item in (SelectList)ViewBag.Categories)
                        {
                            <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-outline-success">
                        <i class="bi bi-filter"></i> Lọc
                    </button>
                    @if (selectedCategoryId.HasValue)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x"></i> Xóa bộ lọc
                        </a>
                    }
                </form>
            </div>
            <div class="col-md-6 text-end">
                <a asp-action="Create" class="btn btn-fruit-primary">
                    <i class="bi bi-plus-circle"></i> Tạo Sản Phẩm Mới
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Products Table -->
<div class="table-responsive">
    <table class="table table-hover cart-table">
        <thead>
            <tr>
                <th style="width: 80px;">Ảnh</th>
                <th>ID</th>
                <th>Tên Sản Phẩm</th>
                <th>Danh Mục</th>
                <th>Tồn Kho</th>
                <th>Đơn Giá</th>
                <th style="width: 200px;">Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var imageFile = FruitImageHelper.GetImageByProductName(item.ProductName);
                <tr>
                    <td>
                        <img src="~/assets/products/@imageFile" alt="@item.ProductName" 
                             class="rounded" style="width: 50px; height: 50px; object-fit: cover;">
                    </td>
                    <td>@item.ProductID</td>
                    <td class="fw-bold">@item.ProductName</td>
                    <td>
                        <span class="badge bg-success">@(item.Category?.CategoryName ?? "N/A")</span>
                    </td>
                    <td>
                        @if (item.UnitsInStock < 20)
                        {
                            <span class="text-danger fw-bold">@item.UnitsInStock</span>
                        }
                        else
                        {
                            @item.UnitsInStock
                        }
                    </td>
                    <td class="text-danger fw-bold">@(item.UnitPrice?.ToString("N0") ?? "0") ₫</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.ProductID" class="btn btn-sm btn-info">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.ProductID" class="btn btn-sm btn-warning">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.ProductID" class="btn btn-sm btn-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-inbox display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">Không có sản phẩm nào</h4>
        <a asp-action="Create" class="btn btn-fruit-primary mt-3">
            <i class="bi bi-plus-circle"></i> Tạo sản phẩm đầu tiên
        </a>
    </div>
}
