@using MyStore.WebApp.Helpers
@model MyStore.Business.Entities.Product

@{
    ViewData["Title"] = "Chi Tiết Sản Phẩm";
    var imageFile = FruitImageHelper.GetImageByProductName(Model.ProductName);
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0 product-card" style="animation: none;">
    <div class="card-body">
        <div class="row">
            <div class="col-md-5 text-center mb-4">
                <img src="~/assets/products/@imageFile" alt="@Model.ProductName" 
                     class="img-fluid rounded shadow" style="max-height: 400px; object-fit: cover;">
            </div>
            <div class="col-md-7">
                <h2 class="fw-bold mb-3" style="color: var(--fruit-primary);">@Model.ProductName</h2>
                
                <div class="mb-4">
                    <span class="badge bg-success fs-6 me-2">
                        <i class="bi bi-check-circle"></i> Còn hàng
                    </span>
                    <span class="badge bg-secondary fs-6">
                        <i class="bi bi-box"></i> @Model.UnitsInStock sản phẩm
                    </span>
                </div>

                <dl class="row fs-5">
                    <dt class="col-sm-4 text-muted"><i class="bi bi-upc"></i> Mã SP</dt>
                    <dd class="col-sm-8 fw-bold">@Model.ProductID</dd>
                    
                    <dt class="col-sm-4 text-muted"><i class="bi bi-tag"></i> Danh Mục</dt>
                    <dd class="col-sm-8">@(Model.Category?.CategoryName ?? "N/A")</dd>
                    
                    <dt class="col-sm-4 text-muted"><i class="bi bi-cash-coin"></i> Đơn Giá</dt>
                    <dd class="col-sm-8">
                        <span class="fs-3 fw-bold" style="color: var(--fruit-danger);">
                            @(Model.UnitPrice?.ToString("N0") ?? "0") ₫
                        </span>
                    </dd>
                </dl>

                <hr class="my-4">

                <!-- Add to Cart Form -->
                <form asp-controller="Cart" asp-action="AddToCartFromDetails" method="post" class="mb-4">
                    <input type="hidden" name="productId" value="@Model.ProductID" />
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <label class="form-label mb-0 fw-bold">Số lượng:</label>
                        </div>
                        <div class="col-auto">
                            <input type="number" name="quantity" value="1" min="1" max="@Model.UnitsInStock" 
                                   class="form-control text-center" style="width: 80px;">
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-fruit-secondary btn-lg">
                                <i class="bi bi-cart-plus"></i> Thêm vào giỏ hàng
                            </button>
                        </div>
                    </div>
                </form>

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.ProductID" class="btn btn-warning">
                        <i class="bi bi-pencil"></i> Chỉnh Sửa
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Quay Lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
