@model MyStore.Business.Entities.Product

@{
    ViewData["Title"] = "Product Details";
}

<h2>Chi Tiết Sản Phẩm</h2>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="row">
            <div class="col-md-4 text-center mb-3">
                <img src="~/assets/products/@Model.ImageFile" alt="@Model.ProductName" class="img-fluid rounded" style="max-height: 300px;">
            </div>
            <div class="col-md-8">
                <dl class="row fs-5">
                    <dt class="col-sm-4 text-muted">Mã Sản Phẩm</dt>
                    <dd class="col-sm-8 fw-bold">@Model.ProductID</dd>
                    
                    <dt class="col-sm-4 text-muted">Tên Sản Phẩm</dt>
                    <dd class="col-sm-8 fw-bold text-success">@Model.ProductName</dd>
                    
                    <dt class="col-sm-4 text-muted">Danh Mục</dt>
                    <dd class="col-sm-8">@(Model.Category?.CategoryName ?? "N/A")</dd>
                    
                    <dt class="col-sm-4 text-muted">Đơn Giá</dt>
                    <dd class="col-sm-8 text-danger fw-bold">@(Model.UnitPrice?.ToString("N0") ?? "0") ₫</dd>
                    
                    <dt class="col-sm-4 text-muted">Số Lượng Tồn</dt>
                    <dd class="col-sm-8">@Model.UnitsInStock</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.ProductID" class="btn btn-warning">Chỉnh Sửa</a>
    <a asp-action="Index" class="btn btn-secondary">Quay Lại Danh Sách</a>
</div>
