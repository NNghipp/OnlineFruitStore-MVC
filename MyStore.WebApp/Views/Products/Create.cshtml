@model MyStore.Business.Entities.Product

@{
    ViewData["Title"] = "Tạo Sản Phẩm Mới";
}

<h2><i class="bi bi-plus-circle"></i> Tạo Sản Phẩm Mới</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ProductName" class="form-label fw-bold">
                        <i class="bi bi-box"></i> Tên sản phẩm *
                    </label>
                    <input asp-for="ProductName" class="form-control" placeholder="Ví dụ: Táo Envy Mỹ" />
                    <span asp-validation-for="ProductName" class="text-danger"></span>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label asp-for="CategoryID" class="form-label fw-bold">
                        <i class="bi bi-tag"></i> Danh mục *
                    </label>
                    <select asp-for="CategoryID" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                    <span asp-validation-for="CategoryID" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="UnitPrice" class="form-label fw-bold">
                        <i class="bi bi-cash-coin"></i> Đơn giá (VNĐ) *
                    </label>
                    <input asp-for="UnitPrice" class="form-control" type="number" step="1000" 
                           placeholder="Ví dụ: 300000" />
                    <span asp-validation-for="UnitPrice" class="text-danger"></span>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label asp-for="UnitsInStock" class="form-label fw-bold">
                        <i class="bi bi-boxes"></i> Số lượng tồn kho
                    </label>
                    <input asp-for="UnitsInStock" class="form-control" type="number" 
                           placeholder="Ví dụ: 50" />
                    <span asp-validation-for="UnitsInStock" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">
                    <i class="bi bi-image"></i> Hình ảnh sản phẩm
                </label>
                <input type="file" name="imageFile" class="form-control" accept="image/*" id="imageInput" />
                <small class="text-muted">Chấp nhận: JPG, PNG, GIF. Tối đa 5MB</small>
                
                <div id="imagePreview" class="mt-3" style="display: none;">
                    <img id="previewImg" src="" alt="Preview" class="img-thumbnail" style="max-height: 200px;">
                </div>
            </div>

            <hr class="my-4">

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-fruit-primary btn-lg">
                    <i class="bi bi-check-circle"></i> Tạo Sản Phẩm
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-lg">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Image preview
        document.getElementById('imageInput').addEventListener('change', function(e) {
            var file = e.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('previewImg').src = e.target.result;
                    document.getElementById('imagePreview').style.display = 'block';
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}
