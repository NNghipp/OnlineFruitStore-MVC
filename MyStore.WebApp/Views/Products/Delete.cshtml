@model MyStore.Business.Entities.Product

@{
    ViewData["Title"] = "Delete Product";
}

<h2>Xóa Sản Phẩm</h2>

<div class="alert alert-danger">
    <h5>Bạn có chắc chắn muốn xóa sản phẩm này không?</h5>
</div>

<div class="card shadow-sm border-danger">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Tên Sản Phẩm</dt>
            <dd class="col-sm-9 fw-bold">@Model.ProductName</dd>
            
            <dt class="col-sm-3">Danh Mục</dt>
            <dd class="col-sm-9">@(Model.Category?.CategoryName ?? "N/A")</dd>
            
            <dt class="col-sm-3">Đơn Giá</dt>
            <dd class="col-sm-9 text-danger">@(Model.UnitPrice?.ToString("N0") ?? "0") ₫</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="ProductID" />
    <button type="submit" class="btn btn-danger">Xóa Ngay</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy Bỏ</a>
</form>
