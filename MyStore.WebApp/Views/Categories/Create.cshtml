@model MyStore.Business.Entities.Category

@{
    ViewData["Title"] = "Tạo Danh Mục Mới";
}

<h2><i class="bi bi-plus-circle"></i> Tạo Danh Mục Mới</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div class="mb-4">
                <label asp-for="CategoryName" class="form-label fw-bold">
                    <i class="bi bi-tag"></i> Tên danh mục *
                </label>
                <input asp-for="CategoryName" class="form-control form-control-lg" 
                       placeholder="Ví dụ: Trái cây nhập khẩu" />
                <span asp-validation-for="CategoryName" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-fruit-primary btn-lg">
                    <i class="bi bi-check-circle"></i> Tạo Danh Mục
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-lg">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
