@model MyStore.WebApp.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi Mật Khẩu";
}

<div class="profile-page">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm profile-content">
                <div class="card-header profile-header">
                    <h4 class="mb-0"><i class="bi bi-key"></i> Đổi Mật Khẩu</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="ChangePassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="CurrentPassword" class="form-label fw-bold">
                                <i class="bi bi-lock"></i> Mật khẩu hiện tại
                            </label>
                            <input asp-for="CurrentPassword" class="form-control form-control-lg" />
                            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="NewPassword" class="form-label fw-bold">
                                <i class="bi bi-lock-fill"></i> Mật khẩu mới
                            </label>
                            <input asp-for="NewPassword" class="form-control form-control-lg" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                            <small class="text-muted">Mật khẩu phải có ít nhất 6 ký tự</small>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmNewPassword" class="form-label fw-bold">
                                <i class="bi bi-check-circle"></i> Xác nhận mật khẩu mới
                            </label>
                            <input asp-for="ConfirmNewPassword" class="form-control form-control-lg" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-fruit-primary btn-lg">
                                <i class="bi bi-check"></i> Đổi Mật Khẩu
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .profile-page {
        padding: 2rem 0;
    }
    
    .profile-content {
        border-radius: 15px;
        border: none;
    }
    
    .profile-header {
        background: #3d5a4c;
        color: white;
        border-radius: 15px 15px 0 0 !important;
        padding: 1.25rem;
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
